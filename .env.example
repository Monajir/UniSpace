# Copy this file to .env before changing local Compose defaults.
POSTGRES_DB=unispace
POSTGRES_USER=unispace
POSTGRES_PASSWORD=unispace
CLASSROOM_CACHE_ENABLED=true
CLASSROOM_CACHE_TTL=60s

JWT_SECRET=academic-demo-jwt-secret-at-least-32-bytes
JWT_EXPIRATION_MS=1800000

FRONTEND_PORT=8080
BACKEND_PORT=8082
CORS_ALLOWED_ORIGINS=http://localhost:8080

# The demo profile creates a connected, restart-safe presentation dataset.
SPRING_PROFILES_ACTIVE=demo
DEMO_ADMIN_EMAIL=admin@iut-dhaka.edu
DEMO_ADMIN_PASSWORD=admin12345
DEMO_ADMIN_NAME=Demo Administrator
