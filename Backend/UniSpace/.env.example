SERVER_PORT=8082
DATABASE_URL=jdbc:postgresql://localhost:5432/unispace
DATABASE_USERNAME=unispace
DATABASE_PASSWORD=unispace
CORS_ALLOWED_ORIGINS=http://localhost:8080
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=1800000
SPRING_PROFILES_ACTIVE=demo
DEMO_ADMIN_EMAIL=admin@iut-dhaka.edu
DEMO_ADMIN_PASSWORD=admin12345
DEMO_ADMIN_NAME=Demo Administrator

# Phase 5 migration profile only. Keep MIGRATION_DRY_RUN=true for the first pass.
MIGRATION_INPUT_DIR=D:/path/to/mongo-export
MIGRATION_DRY_RUN=true
MIGRATION_REPORT_FILE=D:/path/to/migration-report.json
